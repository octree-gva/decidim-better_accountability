<%= render partial: "decidim/accountability/results/home_header" %>
  <h2 class="projects-grid__title"><%= t("grid.title", scope: "decidim.better_accountability" )%></h2>
  <section class="projects-grid">
    <% results.each do |result| %>
      <div class="result_card">
        <div class="result_card__content">
          <%= link_to result_path(result, **pagination_params), class: "result_card__header" do %>
            <h3 class="result_card__headertext">
              <%= translated_attribute(result.title) %>
            </h3>
          <% end %>
          <div class="result_card__description">
            <%= strip_tags(html_truncate(decidim_sanitize_admin(translated_attribute(result.description)), length: 500)) %>
          </div>
        </div>
        <div class="result_card__metas">
          <% if result.status %>
            <div class="result_card__status">
              <div class="result_card__statustitle">
                <span title="<%= t("models.result.fields.status", scope: "decidim.accountability" ) %>" aria-label="<%= t("models.result.fields.status", scope: "decidim.accountability" ) %>">
                  <%= translated_attribute(result.status.name) %>
                </span>
              </div>
              <% if translated_attribute(result.status.description).present? %>
                <div class="result_card__status_description">
                    <%= html_truncate(translated_attribute(result.status.description), length: 150) %>
                </div>
                <% end %>
            </div>
            <% end %>

            <% if component_settings.display_progress_enabled? && result.progress.present? %>
              <div class="result_card__progress">
                <span class="result_card__progressnumber">
                  <%= display_percentage result.progress %>
                </span>
                <div class="result_card__progressbar progress">
                  <div class="progress-meter" style="width:<%= result.progress %>%"></div>
                </div>
              </div>
            <% end %>
          </div>
          <%= link_to t("grid.view_btn", scope: "decidim.better_accountability" ), result_path(result, better_view: :grid, **pagination_params),
            class: "result_card__actions" %>
      </div>
      <% end %>
  </section>
<div class="projects-grid__pagination">
  <%= decidim_paginate results, order_start_time: params[:order_start_time], with_scope: params.dig(:filter,
  :with_scope), better_view: :grid %>
</div>
