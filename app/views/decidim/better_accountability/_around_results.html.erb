<div class="better-accountability">
    <%= render partial: "decidim/better_accountability/menu", locals: {additional_classes: "show-for-medium"} %>
    <div class="tabbed-result">
        <% if better_view_grid? %>
        <div class="tab tab--percent">
            <%= render partial: "decidim/better_accountability/grid_view"  %>
        </div>
        <% end %>
        <% if better_view_percentage? %>
        <%= render partial: "decidim/better_accountability/menu", locals: {additional_classes: "show-for-small-only"} %>

        <div class="tab tab--percent">
            <%= render_original  %>
        </div>
        <% end %>
    </div>
</div>