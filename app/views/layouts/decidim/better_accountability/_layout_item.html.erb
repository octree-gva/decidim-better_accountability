<div role="complementary">
  <%= yield :item_header %>
</div>
<div class="layout-item layout-item--better-accountability">
  <% if better_view_query == "grid" %>
    <%= link_to root_path(better_view: better_view_params, **pagination_params), class: "better_accountability__goback" do %>
      <%= icon("arrow-left-s-line").html_safe %>
      <span><%= t('navigation.go_back', scope: 'decidim.better_accountability') %></span>
    <% end %>
  <% end %>

  <main class="layout-item__main">
    <% if params[:included_in] %>
      <%= render partial: "layouts/decidim/shared/linked_resource" %>
    <% end %>

    <%= yield %>
  </main>
    <aside class="layout-item__aside" aria-label="aside">
      <%= yield :aside %>
    </aside>
  <%# this aside is for moving comments and versions at the bottom of the page only in responsive. %>
  <% if content_for?(:item_footer) %>
    <aside class="layout-item__main layout-item__aside--footer" aria-label="comments">
      <%= yield :item_footer %>
    </aside>
  <% end %>
</div>